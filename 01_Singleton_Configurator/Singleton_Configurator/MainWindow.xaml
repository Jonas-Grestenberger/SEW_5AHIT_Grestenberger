<Window x:Class="Singleton_Configurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HTL-Clubbing Karten Calculator" Height="230" Width="760"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Überschrift -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="6" Margin="0,0,0,10">
            <TextBlock Text="HTL-Clubbing Karten Calculator" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <Separator Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Eingabefelder -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Preis Netto(€/Stk):" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtPrice" Margin="0,2,20,2" Height="22"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="Menge:" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox   Grid.Row="1" Grid.Column="4" x:Name="txtQuantity" Margin="0,2,10,2" Height="22"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Rabatt (%):" VerticalAlignment="Center"/>
        <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" x:Name="txtDiscount" Margin="0,2,20,2" Height="22"/>
        <TextBlock Grid.Row="2" Grid.Column="3" Text="Steuer (%):" VerticalAlignment="Center" Margin="10,0,0,0"/>
        <TextBox   Grid.Row="2" Grid.Column="4" x:Name="txtVat" Margin="0,2,10,2" Height="22"/>

        <Button Grid.Row="1" Grid.RowSpan="2" Grid.Column="5" x:Name="btnCalc" Content="Berechnen"
                Width="100" Height="30" HorizontalAlignment="Left" Click="BtnCalc_Click"/>

        <!-- Anzeigefelder -->
        <StackPanel Grid.Row="3" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Netto:" Width="120"/>
            <TextBlock x:Name="lblNetto" Width="120" FontWeight="Bold"/>
            <TextBlock Text="Steuer:" Width="80"/>
            <TextBlock x:Name="lblVat" Width="120" FontWeight="Bold"/>
            <TextBlock Text="Brutto:" Width="80"/>
            <TextBlock x:Name="lblBrutto" Width="120" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>
